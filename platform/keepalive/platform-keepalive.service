[Unit]
Description=Keep this Always Free A1 instance out of Oracle's idle reclaim (platform/keepalive)

[Service]
Environment=KEEPALIVE_MB=1536
ExecStart=/usr/bin/python3 /opt/platform/keepalive/keepalive.py
Restart=always
DynamicUser=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
Nice=19
MemoryMax=1700M

[Install]
WantedBy=multi-user.target
