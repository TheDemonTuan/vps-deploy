[Unit]
Description=Edge node peer: CrowdSec ban exchange and checks of the other node (platform/peer)
After=network-online.target crowdsec.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/platform/peer/peer.sh
TimeoutStartSec=50
StateDirectory=platform-peer
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# node-exporter's textfile directory (platform/monitor); "-": the unit still starts without it.
ReadWritePaths=/srv/platform-sync/crowdsec -/var/lib/node-exporter
