[Unit]
Description=Edge node peer: edge lease, writer duties and follower checks (platform/peer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/platform/peer/peer.sh
TimeoutStartSec=50
StateDirectory=platform-peer
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# node-exporter's textfile directory (platform/monitor) and the writer's daily backups; "-": the
# unit still starts without them.
ReadWritePaths=-/var/lib/node-exporter -/var/lib/docker/volumes/mc-hub-api-data/_data/backups
