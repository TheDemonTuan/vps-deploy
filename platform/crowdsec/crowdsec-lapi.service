[Unit]
Description=The fleet's CrowdSec LAPI on 172.31.254.1:8080 over SSH, on a node that does not hold it (platform/crowdsec)
# The address is the edge-crowdsec bridge's gateway: it exists once Docker is up.
After=network-online.target docker.service
Wants=network-online.target
Before=crowdsec.service crowdsec-firewall-bouncer.service
# lapi.sh writes it with the LAPI node's address, and removes it on the LAPI node.
ConditionPathExists=/etc/platform/crowdsec-lapi.env

[Service]
User=crowdsec-lapi
EnvironmentFile=/etc/platform/crowdsec-lapi.env
# Through sh: SELinux does not let systemd exec ssh directly. The key on the LAPI node only
# forwards to its 172.31.254.1:8080; the host key is pinned (ansible/, hosts/*.yml).
ExecStart=/bin/sh -c 'exec /usr/bin/ssh -N -T -F /dev/null -i /etc/platform/lapi_key -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/platform/known_hosts -o GlobalKnownHostsFile=/dev/null -L 172.31.254.1:8080:172.31.254.1:8080 crowdsec-lapi@${LAPI_SSH}'
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
