 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": false,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Edge routing (Cloudflare Worker edge-lb)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests per node (5 min)",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "edge"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "edge"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "/analytics_engine/sql",
     "url_options": {
      "method": "POST",
      "body_type": "raw",
      "body_content_type": "text/plain",
      "data": "SELECT toUnixTimestamp(toStartOfInterval(timestamp, INTERVAL '300' SECOND)) * 1000 AS t, blob2 AS node, SUM(_sample_interval) AS v FROM edge_lb WHERE timestamp >= toDateTime(${__from:date:seconds}) AND timestamp <= toDateTime(${__to:date:seconds}) GROUP BY t, node ORDER BY t FORMAT JSON"
     },
     "root_selector": "data",
     "columns": [
      {
       "selector": "t",
       "text": "time",
       "type": "timestamp_epoch"
      },
      {
       "selector": "node",
       "text": "node",
       "type": "string"
      },
      {
       "selector": "v",
       "text": "value",
       "type": "number"
      }
     ]
    }
   ],
   "transformations": [
    {
     "id": "prepareTimeSeries",
     "options": {
      "format": "multi"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "displayName": "${__field.labels.node}",
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Where edge-lb sent each request. 'edge' = answered at the edge (Cache API hit, R2 image, queued write) without a node.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "p95 time to response per node (ms)",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "edge"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "edge"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "/analytics_engine/sql",
     "url_options": {
      "method": "POST",
      "body_type": "raw",
      "body_content_type": "text/plain",
      "data": "SELECT toUnixTimestamp(toStartOfInterval(timestamp, INTERVAL '300' SECOND)) * 1000 AS t, blob2 AS node, quantileWeighted(0.95)(double2, _sample_interval) AS v FROM edge_lb WHERE timestamp >= toDateTime(${__from:date:seconds}) AND timestamp <= toDateTime(${__to:date:seconds}) GROUP BY t, node ORDER BY t FORMAT JSON"
     },
     "root_selector": "data",
     "columns": [
      {
       "selector": "t",
       "text": "time",
       "type": "timestamp_epoch"
      },
      {
       "selector": "node",
       "text": "node",
       "type": "string"
      },
      {
       "selector": "v",
       "text": "value",
       "type": "number"
      }
     ]
    }
   ],
   "transformations": [
    {
     "id": "prepareTimeSeries",
     "options": {
      "format": "multi"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "displayName": "${__field.labels.node}",
     "unit": "ms",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Errors per node (5xx or no response)",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "edge"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "edge"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "/analytics_engine/sql",
     "url_options": {
      "method": "POST",
      "body_type": "raw",
      "body_content_type": "text/plain",
      "data": "SELECT toUnixTimestamp(toStartOfInterval(timestamp, INTERVAL '300' SECOND)) * 1000 AS t, blob2 AS node, SUM(IF(double1 >= 500 OR double1 = 0, _sample_interval, 0)) AS v FROM edge_lb WHERE timestamp >= toDateTime(${__from:date:seconds}) AND timestamp <= toDateTime(${__to:date:seconds}) GROUP BY t, node ORDER BY t FORMAT JSON"
     },
     "root_selector": "data",
     "columns": [
      {
       "selector": "t",
       "text": "time",
       "type": "timestamp_epoch"
      },
      {
       "selector": "node",
       "text": "node",
       "type": "string"
      },
      {
       "selector": "v",
       "text": "value",
       "type": "number"
      }
     ]
    }
   ],
   "transformations": [
    {
     "id": "prepareTimeSeries",
     "options": {
      "format": "multi"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "displayName": "${__field.labels.node}",
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 4
  },
  {
   "type": "table",
   "title": "By node, outcome and host (time range)",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "edge"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "edge"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "/analytics_engine/sql",
     "url_options": {
      "method": "POST",
      "body_type": "raw",
      "body_content_type": "text/plain",
      "data": "SELECT blob2 AS node, blob4 AS outcome, blob1 AS host, SUM(_sample_interval) AS requests, SUM(IF(double1 >= 500 OR double1 = 0, _sample_interval, 0)) AS errors, quantileWeighted(0.95)(double2, _sample_interval) AS p95_ms FROM edge_lb WHERE timestamp >= toDateTime(${__from:date:seconds}) AND timestamp <= toDateTime(${__to:date:seconds}) GROUP BY node, outcome, host ORDER BY requests DESC FORMAT JSON"
     },
     "root_selector": "data",
     "columns": [
      {
       "selector": "node",
       "text": "node",
       "type": "string"
      },
      {
       "selector": "outcome",
       "text": "outcome",
       "type": "string"
      },
      {
       "selector": "host",
       "text": "host",
       "type": "string"
      },
      {
       "selector": "requests",
       "text": "requests",
       "type": "number"
      },
      {
       "selector": "errors",
       "text": "errors",
       "type": "number"
      },
      {
       "selector": "p95_ms",
       "text": "p95_ms",
       "type": "number"
      }
     ]
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "indexByName": {"node": 0, "outcome": 1, "host": 2, "requests": 3, "errors": 4, "p95_ms": 5}
     }
    }
   ],
   "description": "outcome: origin = sent to the node, hit = edge Cache API, stale = cache served because every node failed, queued = reader write held in the Queue, bucket = image from R2.",
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "id": 5
  },
