{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Registered deployment manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "app",
        "strategy",
        "platform",
        "runtime",
        "health",
        "route"
    ],
    "properties": {
        "version": {
            "const": 1
        },
        "app": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?$"
        },
        "strategy": {
            "enum": [
                "blue-green",
                "penpot"
            ]
        },
        "image": {
            "type": "string",
            "pattern": "^(?:ghcr\\.io/[a-z0-9./_-]+|localhost:5000/[a-z0-9-]+)$"
        },
        "images": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frontend", "backend", "exporter", "mcp"],
            "properties": {
                "frontend": {"const": "ghcr.io/thedemontuan/penpot-frontend"},
                "backend": {"const": "ghcr.io/thedemontuan/penpot-backend"},
                "exporter": {"const": "ghcr.io/thedemontuan/penpot-exporter"},
                "mcp": {"const": "ghcr.io/thedemontuan/penpot-mcp"}
            }
        },
        "platform": {
            "const": "linux/arm64"
        },
        "build": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "dockerfile"
            ],
            "properties": {
                "dockerfile": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"
                }
            }
        },
        "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "port"
            ],
            "properties": {
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            }
        },
        "health": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "timeout_seconds"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "pattern": "^/[A-Za-z0-9._/-]*$"
                },
                "timeout_seconds": {
                    "enum": [60, 180]
                }
            }
        },
        "route": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "timeout_seconds"
            ],
            "properties": {
                "timeout_seconds": {
                    "const": 30
                }
            }
        },
        "rtk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image"
            ],
            "properties": {
                "image": {
                    "type": "string",
                    "pattern": "^ghcr\\.io/[a-z0-9./_-]+$"
                }
            }
        },
        "cgw": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image"
            ],
            "properties": {
                "image": {
                    "const": "ghcr.io/thedemontuan/9router-cgw-runtime"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {"properties": {"strategy": {"const": "penpot"}}, "required": ["strategy"]},
            "then": {
                "required": ["images"],
                "not": {"anyOf": [
                    {"required": ["image"]}, {"required": ["build"]},
                    {"required": ["rtk"]}, {"required": ["cgw"]}
                ]},
                "properties": {
                    "app": {"const": "penpot"},
                    "runtime": {"properties": {"port": {"const": 8080}}},
                    "health": {"properties": {"path": {"const": "/readyz"}, "timeout_seconds": {"const": 180}}}
                }
            },
            "else": {
                "required": ["image"],
                "not": {"required": ["images"]},
                "properties": {"health": {"properties": {"timeout_seconds": {"const": 60}}}}
            }
        },
        {
            "if": {
                "required": [
                    "rtk"
                ]
            },
            "then": {
                "properties": {
                    "strategy": {
                        "const": "blue-green"
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "cgw"
                ]
            },
            "then": {
                "properties": {
                    "strategy": {
                        "const": "blue-green"
                    },
                    "app": {
                        "const": "9router"
                    }
                }
            }
        }
    ]
}
