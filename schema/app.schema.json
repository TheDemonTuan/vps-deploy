{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Registered deployment manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "app",
        "strategy",
        "image",
        "platform",
        "runtime",
        "health",
        "route"
    ],
    "properties": {
        "version": {
            "const": 1
        },
        "app": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?$"
        },
        "strategy": {
            "enum": [
                "blue-green",
                "recreate"
            ]
        },
        "image": {
            "type": "string",
            "pattern": "^(?:ghcr\\.io/[a-z0-9./_-]+|localhost:5000/[a-z0-9-]+)$"
        },
        "platform": {
            "const": "linux/arm64"
        },
        "build": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "dockerfile"
            ],
            "properties": {
                "dockerfile": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"
                }
            }
        },
        "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "port"
            ],
            "properties": {
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            }
        },
        "health": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "timeout_seconds"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "pattern": "^/[A-Za-z0-9._/-]*$"
                },
                "timeout_seconds": {
                    "const": 60
                }
            }
        },
        "route": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "timeout_seconds"
            ],
            "properties": {
                "timeout_seconds": {
                    "const": 30
                }
            }
        },
        "rtk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image"
            ],
            "properties": {
                "image": {
                    "type": "string",
                    "pattern": "^ghcr\\.io/[a-z0-9./_-]+$"
                }
            }
        },
        "cgw": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image"
            ],
            "properties": {
                "image": {
                    "const": "ghcr.io/thedemontuan/9router-cgw-runtime"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "required": [
                    "rtk"
                ]
            },
            "then": {
                "properties": {
                    "strategy": {
                        "const": "blue-green"
                    }
                }
            }
        },
        {
            "if": {
                "required": [
                    "cgw"
                ]
            },
            "then": {
                "properties": {
                    "strategy": {
                        "const": "blue-green"
                    },
                    "app": {
                        "const": "9router"
                    }
                }
            }
        }
    ]
}
